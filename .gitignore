# Build output
bin/
*.exe
*.syso
.task/

# The brand icon sources are committed: build/appicon.png (1024x1024)
# and the generated build/windows/icon.ico. Note: `wails3 build`
# regenerates the .ico from appicon.png.

# Frontend
frontend/dist/
frontend/node_modules/

# Go
*.test
*.out

# Portable runtime data created beside the executable when running
# from the repository root (WebView2 holds cookies and cache).
webview2-data/
config/
kernels/

# DeBrowser runtime data — never commit user data
*.db
*.db-shm
*.db-wal
data/
profiles/
logs/
backups/

# Local configuration and secrets
*.local.*
.env
.env.*
!.env.example
*subscription*.txt
*proxy*.local.*

# Browser user data and cookies (must never be committed)
**/User Data/
**/Cookies
**/Login Data

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Temporary files
tmp/
*.tmp
*.log
